[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="platforms"
2d_physics/layer_3="player"
2d_physics/layer_4="enemies"
2d_physics/layer_5="player_attacks"
2d_physics/layer_6="enemy_attacks"
2d_physics/layer_7="dropped_items"
2d_physics/layer_8="npcs"
2d_physics/layer_9="triggers"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.11, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
