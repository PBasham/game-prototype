#!/usr/bin/env python
# Phase 94: builds addons/voxel_native/bin (the C++ water and sand step). See
# docs/code-map.md "Native code" for the commands.
import os

env = SConscript("godot-cpp/SConstruct")  # scons api_version=4.7 platform=... target=...
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")
out = "../addons/voxel_native/bin/libvoxel_native{}{}".format(env["suffix"], env["SHLIBSUFFIX"])
library = env.SharedLibrary(out, source=sources)
Default(library)
